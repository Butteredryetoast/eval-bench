# Configuration example. Keep secrets out of the bundle.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=8787
OBSIDIAN_VAULT_PATH="/absolute/path/to/your/Obsidian Vault"
OBSIDIAN_LIBRARY_PATH="公众号写作结构库"
RAG_ENGINE=haystack
RAG_THREADS=2
RAG_RANK_CANDIDATES=20
RAG_MIN_RERANK_SCORE=-5
# Existing data remains outside the code release:
# RAG_CACHE_DIR=/absolute/path/to/existing/project/.rag-cache
# RAG_MODELS_DIR=/absolute/path/to/existing/project/.rag-cache/models
