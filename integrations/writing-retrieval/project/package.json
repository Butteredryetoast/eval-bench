    "start": "node server/start.mjs",
    "rag:setup": "node scripts/setup-rag.mjs",
    "rag:index": "node scripts/index-rag.mjs",
    "test:rag": "node scripts/test-rag.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "vite": "6.4.2",
    "yaml": "^2.9.1"
  }
}
